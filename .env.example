# Comma-separated WhatsApp sender IDs allowed to command the bot (THE ONLY AUTH — keep it tight).
# WhatsApp now identifies senders by a "LID" (e.g. 1234567890123456@lid), not the phone JID.
# To find yours: leave this empty, start the bridge, message the bot, and read the console —
# it logs `ignored msg from <id>`. Put that <id> here. Phone JIDs like 15551234567@s.whatsapp.net also work.
WA_ALLOWED=

# Path to the Claude Code CLI (must already be logged in). Use "claude" if it's on PATH.
CLAUDE_BIN=claude

# Default model: sonnet (balanced) | haiku (fastest) | opus (most capable, slowest). Switch live with "use <model>".
CLAUDE_MODEL=sonnet

# Working directory for Claude + shell commands (defaults to $HOME). Put a CLAUDE.md here for standing instructions.
WORK_DIR=

# Timeouts (ms)
TURN_TIMEOUT_MS=240000
SHELL_TIMEOUT_MS=300000

# Install: edit paths/User, then:
#   sudo cp wa-bridge.service.example /etc/systemd/system/wa-bridge.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now wa-bridge
[Unit]
Description=WhatsApp -> Claude bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/whatsapp-claude-bridge
EnvironmentFile=/home/YOUR_USER/whatsapp-claude-bridge/.env
# Force IPv4 if your host's IPv6 egress is broken (a common cause of the WhatsApp socket timing out):
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/usr/bin/node /home/YOUR_USER/whatsapp-claude-bridge/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
